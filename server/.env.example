# UniSphere Backend Environment Configuration
# Copy this file to .env and fill in your actual values (DO NOT commit .env to Git)

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/unisphere?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/unisphere?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure 32+ character random strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_32_characters_minimum
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_32_characters_minimum

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI Provider Configuration (Groq or Anthropic Claude)
GROQ_API_KEY=gsk_your_groq_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
